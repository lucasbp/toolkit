<idea-plugin>
    <id>io.github.lucasbp.datagrip-toolkit</id>
    <name>SQL Toolkit</name>
    <vendor>LucasBP</vendor>
    <description><![CDATA[Visual MySQL and Aurora account management, scoped schema and table permissions, explicit role changes and quick SELECT templates. Reuses DataGrip connections. Reviews changes before applying and reloads privileges after application when selected.]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.database</depends>
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="SQL Toolkit" anchor="right" factoryClass="io.github.lucasbp.datagriptoolkit.ui.ToolkitToolWindowFactory"/>
    </extensions>
    <actions>
        <group id="LucasBP.DataGripToolkit.QuickQueries" text="Consultas rápidas" popup="true">
            <add-to-group group-id="DatabaseViewPopupMenu" anchor="last"/>
            <action id="LucasBP.DataGripToolkit.Select1000" class="io.github.lucasbp.datagriptoolkit.ui.QuickSelectAction" text="SELECT das primeiras 1000 linhas"/>
            <action id="LucasBP.DataGripToolkit.SelectColumns" class="io.github.lucasbp.datagriptoolkit.ui.QuickSelectAction$Columns" text="SELECT com nomes das colunas"/>
            <action id="LucasBP.DataGripToolkit.Count" class="io.github.lucasbp.datagriptoolkit.ui.QuickSelectAction$Count" text="Contar registros"/>
        </group>
    </actions>
</idea-plugin>
